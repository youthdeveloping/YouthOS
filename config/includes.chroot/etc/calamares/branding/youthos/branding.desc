# YouthOS 설치 프로그램(Calamares) 브랜딩
---
componentName: youthos

welcomeStyleCalamares: true
welcomeExpandingLogo: true

windowExpanding: normal
windowSize: 900px,600px
windowPlacement: center

sidebar: qml
navigation: widget

strings:
    productName:         YouthOS
    shortProductName:    YouthOS
    version:             0.1
    shortVersion:        0.1
    versionedName:       YouthOS 0.1
    shortVersionedName:  YouthOS 0.1
    bootloaderEntryName: YouthOS
    productUrl:          https://youthdeveloping.github.io
    supportUrl:          https://github.com/youthdeveloping/YouthOS/issues
    knownIssuesUrl:      https://github.com/youthdeveloping/YouthOS/issues
    releaseNotesUrl:     https://github.com/youthdeveloping/YouthOS/releases

images:
    productLogo:         "logo.png"
    productIcon:         "icon.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"
slideshowAPI:            2

style:
    sidebarBackground:     "#0f172a"
    sidebarText:           "#e2e8f0"
    sidebarTextSelect:     "#0f172a"
    sidebarTextHighlight:  "#38bdf8"
